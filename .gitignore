# OS / エディタのゴミ
.DS_Store

# 制作用ソース・バックアップ（ゲーム動作には不要・サイズ大なので公開から除外）
assets/_source/

# 開発ツール（ゲーム本体に不要）
.claude/
.codex/
__pycache__/
*.pyc

# 手動バックアップ（game.js.bak-<sha> 等。ローカル控えなので公開・追跡しない）
*.bak-*

# Cloudflare/wrangler のローカル状態（ローカルD1のsqlite実体など。本番とは無関係）
.wrangler/
node_modules/

# Supabaseからの移行時に取得したデータ控え（同じ165件は db/seed.sql にあるため重複）
backup/

# wrangler.toml はPagesのGitビルドでfunctions検出を阻害したためリポジトリ管理外にした
# （D1バインディングはPagesプロジェクト設定側に保存済み）。ローカル開発用の控えのみ残す。
wrangler.toml
wrangler.toml.local

# 未参照の参考画像（サイトでは使っていないため公開・追跡しない）
きつねたぬき関西関東の違い.jpg
